+def preflight_gradient_audit(total, classification, cc, mscl, cscl, model):
+    """Inspect the first synthetic/probe graph without accumulating parameter gradients."""
+    before = rng_hash()
+    names, parameters = zip(*[(name, p) for name, p in model.named_parameters() if p.requires_grad])
+    original_grads = [None if p.grad is None else p.grad.detach().cpu().clone() for p in parameters]
+    assert torch.is_tensor(cc) and cc.requires_grad, 'CC has no differentiable active margin in the first probe batch'
+    auxiliary = [(name, value) for name, value in [('MSCL', mscl), ('CSCL', cscl)]
+                 if torch.is_tensor(value) and value.requires_grad]
+    gradients = torch.autograd.grad(total, tuple(parameters) + tuple(value for _, value in auxiliary),
+                                    retain_graph=True, allow_unused=True)
+    total_gradients = [None if value is None else value.detach().cpu() for value in gradients[:len(parameters)]]
+    assert all(value is None for value in gradients[len(parameters):]), 'HSCL is still on the objective gradient path'
+    del gradients
+    classification_gradients = [None if value is None else value.detach().cpu() for value in
+        torch.autograd.grad(classification, parameters, retain_graph=True, allow_unused=True)]
+    cc_gradients = [None if value is None else value.detach().cpu() for value in
+        torch.autograd.grad(cc, parameters, retain_graph=True, allow_unused=True)]
+    squared = {'classification': 0., 'cc': 0., 'total': 0., 'cc_backbone': 0.}
+    maximum_difference, compared, backbone_nonzero = 0., 0, []
+    for name, actual, cls, rank in zip(names, total_gradients, classification_gradients, cc_gradients):
+        for key, value in [('classification', cls), ('cc', rank), ('total', actual)]:
+            if value is not None:
+                assert torch.isfinite(value).all().item(), 'Nonfinite probe gradient: ' + key
+                squared[key] += value.double().square().sum().item()
+        if rank is not None and name.startswith(('gru_l.', 'linear_l.', 'linear_a.', 'linear_v.')):
+            norm = rank.double().square().sum().item()
+            squared['cc_backbone'] += norm
+            if norm > 0:
+                backbone_nonzero.append(name)
+        if cls is None and rank is None:
+            assert actual is None
+            continue
+        expected = (cls if cls is not None else torch.zeros_like(rank)) + .002 * (rank if rank is not None else torch.zeros_like(cls))
+        assert actual is not None and torch.allclose(actual, expected, rtol=1e-4, atol=1e-5), name
+        maximum_difference = max(maximum_difference, (actual-expected).abs().max().item())
+        compared += 1
+    assert squared['cc_backbone'] > 0, 'CC gradient did not reach a registered backbone parameter'
+    for old, parameter in zip(original_grads, parameters):
+        assert (parameter.grad is None if old is None else parameter.grad is not None and torch.equal(old, parameter.grad.detach().cpu()))
+    after = rng_hash()
+    assert before == after
+    return {'status': 'passed', 'preflight_only': True, 'additional_model_forwards': 0,
+        'parameter_grad_buffers_unchanged': True, 'rng_before': before, 'rng_after': after,
+        'CC_backbone_gradient_nonzero': True, 'CC_backbone_parameters_nonzero': backbone_nonzero,
+        'gradient_l2': {name: math.sqrt(value) for name, value in squared.items()},
+        'total_equals_classification_plus_0p002_CC_gradient': True, 'compared_parameters': compared,
+        'maximum_absolute_gradient_difference': maximum_difference, 'relative_tolerance': 1e-4, 'absolute_tolerance': 1e-5,
+        'MSCL_gradient_wrt_total': None, 'CSCL_gradient_wrt_total': None,
+        'auxiliary_raw_requires_grad': {'MSCL': torch.is_tensor(mscl) and mscl.requires_grad,
+                                      'CSCL': torch.is_tensor(cscl) and cscl.requires_grad},
+        'limit': 'First probe batch only; this does not assert nonzero CC gradients in every formal batch.'}
 
 
