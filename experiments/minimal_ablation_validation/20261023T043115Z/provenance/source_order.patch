+class SourceOrderBatchSampler(CapacitySafeBatchSampler):
+    """Keep eligible source order, with the zero-retry reference RNG budget.
+
+    Consume one private permutation as in the registered XP04 seed, but emit
+    consecutive source indices. This does not advance model/global RNG.
+    """
+    def __iter__(self):
+        indices = list(range(len(self.lengths)))
+        batches = [indices[start:start + self.batch_size]
+                   for start in range(0, len(indices), self.batch_size)]
+        totals = [sum(self.lengths[index] for index in batch) for batch in batches]
+        edges = [total + 3 * len(batch) for total, batch in zip(totals, batches)]
+        nodes = [3 * total for total in totals]
+        if max(edges, default=0) > self.edge_capacity or max(nodes, default=0) > self.node_capacity:
+            raise RuntimeError('source_order exceeds fixed graph capacity; no batches were emitted')
+        torch.randperm(len(self.lengths), generator=self.generator)
+        self.retries = 0
+        self.max_batch_edges = max(edges, default=0)
+        self.max_batch_nodes = max(nodes, default=0)
+        yield from batches
+
+
